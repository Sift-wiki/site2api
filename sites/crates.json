      "trigger": {
        "url": "https://crates.io/search?q={q}&sort={sort}&page={page}"
      },
      "match": {
        "method": "GET",
        "host": "crates.io",
        "path": "/api/v1/crates"
      },
      "response": {
        "format": "json",
        "contentType": "application/json",
        "extract": "crates",
        "pick": [
          "name",
          "maxVersion=max_version",
          "description",
          "downloads",
          "recentDownloads=recent_downloads"
        ],
        "shape": {
          "crates[].name": "string",
          "crates[].downloads": "number",
          "crates[].recent_downloads": "number",
          "crates[].max_version": "string",
          "crates[].description": "string"
        }
      },
      "params": [
        {
          "name": "q",
          "type": "string",
          "required": true,
          "description": "Search terms or crate name.",
          "example": "serde"
        },
        {
          "name": "sort",
          "type": "string",
          "required": false,
          "description": "Sort order: relevance, all-time downloads, recent downloads, recent updates, newly added or alphabetical.",
          "example": "relevance",
          "default": "relevance",
          "enum": [
            "relevance",
            "downloads",
            "recent-downloads",
            "recent-updates",
            "new",
            "alpha"
          ]
        },
        {
          "name": "page",
          "type": "string",
          "required": false,
          "description": "One-based page number.",
          "example": "1",
          "default": "1",
          "pattern": "[1-9][0-9]*",
          "hint": "A positive whole page number"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false,
      "checks": [
        {
          "args": {
            "q": "rand",
            "sort": "alpha",
            "page": "2"
          },
          "expect": "result",
          "purpose": "A different query, alphabetical sort and second page return results"
        },
        {
          "args": {
            "q": "zzqqxxwvnocratematch"
          },
          "expect": "empty",
          "purpose": "A query with no matching crates returns an empty list"
        }
      ]
