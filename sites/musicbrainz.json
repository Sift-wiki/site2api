        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://musicbrainz.org/artist/{mbid}"
      },
      "match": {
        "method": "GET",
        "host": "musicbrainz.org",
        "path": "/artist/*"
      },
      "response": {
        "format": "html",
        "contentType": "text/html; charset=utf-8",
        "html": {
          "items": "table.release-group-list tbody tr",
          "fields": {
            "year": "td:nth-child(1)",
            "title": "td:nth-child(2) a[href^=\"/release-group/\"]",
            "releaseGroupUrl": "td:nth-child(2) a[href^=\"/release-group/\"]@href",
