      "match": {
        "path": "/spaces-json"
      },
      "response": {
        "format": "json",
        "contentType": "application/json; charset=utf-8",
        "extract": "spaces",
        "pick": [
          "id",
          "title",
          "emoji",
          "sdk",
          "likes",
          "lastModified"
        ],
        "shape": {
          "spaces[].emoji": "string",
          "spaces[].id": "string",
          "spaces[].lastModified": "string",
          "spaces[].likes": "number",
          "spaces[].sdk": "string",
          "spaces[].title": "string"
        }
      },
      "params": [
        {
          "name": "q",
          "type": "string",
          "required": true,
          "description": "words in the Space repository id",
          "example": "gradio"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false,
      "checks": [
        {
          "args": {
            "q": "zzqqxxwvnothingmatch"
          },
          "expect": "empty",
          "purpose": "an unmatched name returns an empty list"
        }
      ]
    },
