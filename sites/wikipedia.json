      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false,
      "checks": [
        {
          "args": {
            "title": "Zzqqxx_no_such_page_xyz"
          },
          "expect": "input",
          "purpose": "a missing article is input, not drift"
        }
      ]
    },
