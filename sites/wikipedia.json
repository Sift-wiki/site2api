      },
      "slots": [
        {
          "param": "title",
          "at": [
            "path:1"
          ]
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://en.wikipedia.org/wiki/{title}"
      },
      "match": {
        "method": "GET",
        "host": "en.wikipedia.org",
        "path": "/wiki/*"
      },
      "response": {
        "format": "html",
        "contentType": "text/html; charset=UTF-8",
        "html": {
          "items": "ul.vector-toc-contents li.vector-toc-list-item",
          "fields": {
            "heading": ":scope > a .vector-toc-text",
            "number": ":scope > a .vector-toc-numb",
            "anchor": ":scope > a@href"
          }
        }
      },
      "params": [
        {
          "name": "title",
          "type": "string",
          "required": true,
          "description": "article title or URL key, such as Ada_Lovelace",
          "example": "Ada_Lovelace"
