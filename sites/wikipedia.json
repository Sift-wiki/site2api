    {
      "name": "getRevisions",
      "description": "Recent public page history, newest first: displayed timestamp, editor, edit summary and signed byte change.",
      "request": {
        "method": "GET",
        "url": "https://en.wikipedia.org/w/index.php?title=%7Btitle%7D&action=history",
        "headers": {
          "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/jxl,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
