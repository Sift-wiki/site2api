        ],
        "embedded": {
          "regex": "data-target=\"react-app\\.embeddedData\">(\\{)"
        }
      },
      "params": [
        {
          "name": "owner",
          "type": "string",
          "required": true,
          "description": "the repository owner's user or organization name",
          "example": "sveltejs"
        },
        {
          "name": "repo",
          "type": "string",
          "required": true,
          "description": "the repository name",
          "example": "svelte"
        },
        {
          "name": "query",
          "type": "string",
          "required": false,
          "description": "GitHub issue search filter, including is:pr",
          "example": "is:pr is:open",
          "default": "is:pr is:open"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false,
      "checks": [
        {
          "args": {
            "owner": "sveltejs",
