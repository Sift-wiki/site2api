        },
        {
          "name": "repo",
          "type": "string",
          "required": true,
          "description": "the repository name",
          "example": "node"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false,
      "checks": [
        {
          "args": {
            "owner": "rust-lang",
            "repo": "rust"
          },
          "expect": "result",
          "purpose": "another repository has different releases"
